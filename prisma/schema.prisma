// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  LOAN
  CASH
}

enum AccountOwnerType {
  PERSONAL
  JOINT
  BUSINESS
}

enum MemberRelationship {
  YOURSELF
  PARTNER
  SPOUSE
  FAMILY
  OTHER
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  emailVerified   Boolean   @default(false)
  job             String?
  annualWage      Float?
  businessName    String?
  selectedBanks   String?   @default("[]")
  createdAt       DateTime  @default(now())

  household       Household?
  otpCodes        OtpCode[]
  linkedAccounts  LinkedBankAccount[]
}

model OtpCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
}

model SignUpSession {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  job           String
  annualWage    Float
  businessName  String?
  selectedBanks String    @default("[]")
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model Household {
  id        String   @id @default(cuid())
  name      String   @default("My Household")
  createdAt DateTime @default(now())

  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String? @unique

  members   HouseholdMember[]
  accounts  Account[]
  pots      Pot[]
}

model HouseholdMember {
  id           String              @id @default(cuid())
  name         String
  relationship MemberRelationship  @default(YOURSELF)
  color        String              @default("#3b82f6")
  createdAt    DateTime            @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  accounts         Account[]
  transactions     TransactionAuthor[]
  potContributions PotContribution[]
}

model Account {
  id          String           @id @default(cuid())
  name        String
  institution String?
  kind        AccountKind
  ownerType   AccountOwnerType @default(PERSONAL)
  isBusiness  Boolean          @default(false)
  balance     Float            @default(0)
  currency    String           @default("GBP")
  createdAt   DateTime         @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  owner   HouseholdMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  transactions Transaction[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  icon  String @default("circle")
  color String @default("#6366f1")

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Float
  description String
  merchant    String?
  isBusiness  Boolean  @default(false)
  createdAt   DateTime @default(now())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?

  author   TransactionAuthor? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?
}

model TransactionAuthor {
  id String @id @default(cuid())

  member   HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  transactions Transaction[]
}

model Pot {
  id            String   @id @default(cuid())
  name          String
  icon          String   @default("piggy-bank")
  color         String   @default("#22c55e")
  targetAmount  Float?
  currentAmount Float    @default(0)
  createdAt     DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  contributions PotContribution[]
}

model PotContribution {
  id     String   @id @default(cuid())
  amount Float
  date   DateTime @default(now())

  pot   Pot    @relation(fields: [potId], references: [id], onDelete: Cascade)
  potId String

  member   HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String
}

model LinkedBankAccount {
  id              String    @id @default(cuid())
  plaidItemId     String    @unique
  bankName        String
  accountName     String
  accountNumber   String?
  balance         Float     @default(0)
  currency        String    @default("GBP")
  plaidAccessToken String
  lastSync        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  transactions PlaidTransaction[]
}

model PlaidTransaction {
  id                String   @id @default(cuid())
  plaidTransactionId String  @unique
  date              DateTime
  amount            Float
  description       String
  merchant          String?
  category          String?
  createdAt         DateTime @default(now())

  linkedAccount   LinkedBankAccount @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)
  linkedAccountId String
}
